// Cloudflare configuration for homeopathy-library.
// Top level = local development only (local D1/R2 under .wrangler/, nothing in your account).
// env.dev and env.production are separate deployments with separate resources.
// Resource IDs are not secrets; secrets go in `wrangler secret put` or .dev.vars (ignored by Git).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homeopathy-library-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker runs first on every path so it can enforce Access on pages too.
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "vars": { "ENVIRONMENT": "local", "ALLOW_IMPORTS": "true" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homeopathy-library-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    {
      // Client records, kept apart from the library. Local testing uses made-up clients only.
      "binding": "CLIENTS",
      "database_name": "homeopathy-library-local-clients",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations-clients"
    }
  ],
  "r2_buckets": [{ "binding": "LIBRARY", "bucket_name": "homeopathy-library-local" }],

  "env": {
    "dev": {
      "name": "homeopathy-library-dev",
      // Fails closed (refuses every request) until the Access secrets below are set.
      // Secrets: TEAM_DOMAIN, POLICY_AUD, ALLOWED_EMAILS (wrangler secret put <NAME> --env dev)
      // Client records (made-up test clients only in dev): CLIENT_KEY, CLIENT_EMAILS
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "dev", "ALLOW_IMPORTS": "true" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "homeopathy-library-dev",
          "database_id": "6383eec8-66b0-4b5c-852a-cfdb05a37364",
          "migrations_dir": "migrations"
        },
        {
          "binding": "CLIENTS",
          "database_name": "homeopathy-library-dev-clients",
          "database_id": "c3879e64-2f4b-48f2-a508-e559b6ab5b0a",
          "migrations_dir": "migrations-clients"
        }
      ],
      "r2_buckets": [{ "binding": "LIBRARY", "bucket_name": "homeopathy-library-dev" }]
    },
    "production": {
      "name": "homeopathy-library-prod",
      // Served on its workers.dev URL behind Cloudflare Access, like dev. Fails closed until the secrets are set.
      // Secrets: TEAM_DOMAIN, POLICY_AUD, ALLOWED_EMAILS, CLIENT_KEY, CLIENT_EMAILS
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "ENVIRONMENT": "production", "ALLOW_IMPORTS": "false" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "homeopathy-library-prod",
          "database_id": "REPLACE_WITH_PROD_DATABASE_ID",
          "migrations_dir": "migrations"
        },
        {
          "binding": "CLIENTS",
          "database_name": "homeopathy-library-prod-clients",
          "database_id": "REPLACE_WITH_PROD_CLIENTS_DATABASE_ID",
          "migrations_dir": "migrations-clients"
        }
      ],
      "r2_buckets": [{ "binding": "LIBRARY", "bucket_name": "homeopathy-library-prod" }]
    }
  }
}
